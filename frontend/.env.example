# Where the FastAPI backend runs.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: enables "Open in Google Sheets". An OAuth 2.0 Client ID (type "Web application")
# from Google Cloud Console with this site's URL under "Authorized JavaScript origins" and the
# Google Drive API enabled. Leave empty to hide the feature.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
