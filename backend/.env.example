# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
SHEETCRAFT_MODEL=claude-sonnet-5-5
SHEETCRAFT_EFFORT=medium
SHEETCRAFT_MAX_TOKENS=32000
SHEETCRAFT_REPAIR_ATTEMPTS=1
# A JSON list of the sites allowed to call the API.
SHEETCRAFT_CORS_ORIGINS=["http://localhost:3000"]
SHEETCRAFT_DATA_DIR=data
# Sessions end after this many days without use.
# SHEETCRAFT_SESSION_DAYS=30

# Where the frontend lives; password reset emails link to <app_url>/?reset=<token>.
# SHEETCRAFT_APP_URL=http://localhost:3000

# Outgoing email for password resets. Without SMTP_HOST the reset link is logged instead.
# Port 587 uses STARTTLS, 465 uses TLS.
# SHEETCRAFT_SMTP_HOST=smtp.example.com
# SHEETCRAFT_SMTP_PORT=587
# SHEETCRAFT_SMTP_USER=
# SHEETCRAFT_SMTP_PASSWORD=
# SHEETCRAFT_SMTP_FROM=SheetCraft <noreply@example.com>

# "Sign in with Google": an OAuth 2.0 Client ID (Web application). Use the same ID as the
# frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave empty to hide the button.
# SHEETCRAFT_GOOGLE_CLIENT_ID=

# AI usage limits: requests per rolling 24 hours, per signed-in account or per IP address.
# SHEETCRAFT_AI_LIMIT_ENABLED=true
# SHEETCRAFT_AI_LIMIT_ANONYMOUS=30
# SHEETCRAFT_AI_LIMIT_SIGNED_IN=200
# Behind a reverse proxy, set this so limits use X-Forwarded-For instead of the proxy's address.
# SHEETCRAFT_TRUST_PROXY=false
# Pro plan allowance (needs billing below).
# SHEETCRAFT_AI_LIMIT_PRO=2000

# Live editing across several backend instances. Empty keeps live rooms in one process.
# SHEETCRAFT_REDIS_URL=redis://localhost:6379/0

# Billing through Stripe. Leave empty to keep billing off.
# SHEETCRAFT_STRIPE_SECRET_KEY=
# SHEETCRAFT_STRIPE_PRICE_PRO=
# SHEETCRAFT_STRIPE_WEBHOOK_SECRET=

# Once-a-minute jobs: refresh live data connections and send scheduled email reports.
# SHEETCRAFT_BACKGROUND_JOBS=true
